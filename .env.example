# Copiez ce fichier vers .env.local et remplissez les valeurs
# depuis Supabase : Project Settings → API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paiement — opérateurs par pays (Orange, Moov, Telecel, Malitel, MTN)
# simulate (défaut) = paiement test réussi, aucun débit téléphone
# live + VITE_OPERATORS_LIVE=1 = débit réel après contrats marchands
VITE_PAYMENT_MODE=simulate
# VITE_OPERATORS_LIVE=1
# Production Hostinger VPS :
# VITE_APP_URL=https://afrizones.com
# VITE_API_URL=https://afrizones.com/api
# Dev local :
# VITE_APP_URL=http://localhost:5173
# VITE_API_URL=http://localhost:8787
# Lien APK / page download app livreur (QR dashboard livreur)
# VITE_DRIVER_APK_URL=https://expo.dev/accounts/afrizone002/projects/afrizone-driver/builds
# L'encaissement réel se fait opérateur par opérateur (contrat marchand), pas via FedaPay.

# Assistant IA « Zoni »
# auto (défaut) = tente l'API Hostinger /api/assistant, repli local
# local = réponses issues uniquement de la base de connaissances embarquée
VITE_ASSISTANT_MODE=auto
# Clé IA côté VPS uniquement (/var/www/afrizone-api/.env) : AI_API_KEY, AI_BASE_URL, AI_MODEL

# Emails / media / paiements → API Hostinger
# Sur le VPS (/var/www/afrizone-api/.env) :
#   SMTP_*, EMAIL_HOOK_SECRET, SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   MEDIA_ROOT=/var/www/afrizone-media, MEDIA_SIGN_SECRET
# DB app_settings.email_dispatch_url = https://afrizones.com/api/emails/dispatch

# NE JAMAIS ajouter de clé secret / service_role ici.
# NE JAMAIS préfixer une clé secrète avec VITE_ (elle serait exposée au navigateur).
