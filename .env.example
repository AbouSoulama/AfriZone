# Copiez ce fichier vers .env.local et remplissez les valeurs
# depuis Supabase : Project Settings → API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paiement — CinetPay (nouveau panel, sans Site ID)
# simulate (défaut) = confirmation locale, aucun agrégateur
# live = redirection vers CinetPay Sandbox / Production
VITE_PAYMENT_MODE=simulate
# VITE_APP_URL=http://localhost:5173
# Secrets serveur (pas de VITE_) :
#   CINETPAY_API_KEY=sk_test_...
#   CINETPAY_API_PASSWORD=...   ← à définir dans Ressources → API & sécurité
#   CINETPAY_COUNTRY=BF
#   APP_URL=http://localhost:5173
# Voir supabase/functions/cinetpay-checkout/README.md

# Assistant IA « Zoni »
# auto (défaut) = tente l'Edge Function ai-assistant, repli automatique sur la base locale
# local = réponses issues uniquement de la base de connaissances embarquée
VITE_ASSISTANT_MODE=auto
# Clé IA côté serveur uniquement : voir supabase/functions/ai-assistant/README.md
# AI_API_KEY, AI_BASE_URL, AI_MODEL → secrets Supabase Edge Functions

# Emails transactionnels (côté serveur uniquement — NE PAS préfixer VITE_)
# Voir supabase/functions/order-emails/README.md
# RESEND_API_KEY, EMAIL_HOOK_SECRET, APP_URL → secrets Supabase Edge Functions

# NE JAMAIS ajouter de clé secret / service_role ici.
# NE JAMAIS préfixer une clé secrète avec VITE_ (elle serait exposée au navigateur).
# Les clés Orange / Wave / Resend se configurent en secrets Supabase de la Edge Function.
